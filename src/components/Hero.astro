---
import { Image } from 'astro:assets';
import cartel from '../assets/cartel.png';
import Countdown from './Countdown.astro';
---

<section id="inicio" class="container hero">
	<div class="copy">
		<p class="tagline">¡Corre, comparte, disfruta!</p>
		<h1>
			<span class="line1"><span class="roman">III</span> San Silvestre</span>
			<span class="banner">Casareña</span>
		</h1>
		<p class="lead">
			5 km suaves y divertidos por las calles de El Casar para despedir el año en familia, con
			amigos y, sobre todo, ¡disfrazados!
		</p>

		<dl class="facts">
			<div>
				<dt>Fecha</dt>
				<dd>27/12/26</dd>
			</div>
			<div>
				<dt>Hora</dt>
				<dd>11:00 h</dd>
			</div>
			<div>
				<dt>Precio</dt>
				<dd>8 € <small>/ inscrito</small></dd>
			</div>
		</dl>

		<div class="actions">
			<a href="#inscripcion" class="btn btn-primary">Inscríbete por 8 €</a>
			<a href="#carrera" class="btn btn-outline">Ver detalles</a>
		</div>
	</div>

	<div class="visual">
		<div class="polaroid">
			<Image
				src={cartel}
				alt="Cartel de la III San Silvestre Casareña: corredores disfrazados de Papá Noel, reno, árbol y muñeco de nieve corriendo hacia el pueblo"
				widths={[440, 880]}
				sizes="(max-width: 480px) 100vw, 440px"
				loading="eager"
			/>
		</div>
		<Countdown target="2026-12-27T11:00:00+01:00" />
	</div>
</section>

<style>
	.hero {
		padding-block: 56px 72px;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 48px;
	}

	.copy {
		flex: 1 1 520px;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	.tagline {
		font-family: var(--font-brush);
		font-size: 30px;
		color: var(--green);
		transform: rotate(-3deg);
		align-self: flex-start;
	}

	h1 {
		display: flex;
		flex-direction: column;
		gap: 6px;
		font-family: var(--font-marker);
		font-weight: 400;
		line-height: 1;
	}

	.line1 {
		font-size: clamp(44px, 7vw, 84px);
	}

	.roman {
		color: var(--red);
		margin-right: 0.15em;
	}

	.banner {
		align-self: flex-start;
		background: var(--red);
		color: #fff;
		font-size: clamp(52px, 9vw, 108px);
		line-height: 1.05;
		padding: 8px 40px 14px;
		clip-path: polygon(0 8%, 6% 0, 94% 4%, 100% 0, 97% 50%, 100% 100%, 92% 94%, 8% 100%, 0 92%, 3% 50%);
		transform: rotate(-2deg);
	}

	.lead {
		margin-top: 8px;
		font-size: 20px;
		line-height: 1.55;
		max-width: 520px;
		color: var(--muted);
	}

	.facts {
		margin: 8px 0 0;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		border-block: 2px solid var(--green);
		max-width: 560px;
		color: var(--green);
	}

	.facts > div {
		padding: 14px 12px;
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.facts > div:first-child {
		padding-left: 0;
	}

	.facts > div + div {
		border-left: 2px solid var(--green);
	}

	dt {
		font-weight: 800;
		font-size: 13px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	dd {
		margin: 0;
		font-family: var(--font-numbers);
		font-size: clamp(20px, 3vw, 26px);
	}

	dd small {
		font-family: var(--font-body);
		font-size: 14px;
		font-weight: 700;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		margin-top: 12px;
	}

	.visual {
		flex: 1 1 380px;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 20px;
		align-items: center;
	}

	.polaroid {
		background: #fff;
		padding: 14px 14px 18px;
		box-shadow: 0 18px 40px rgba(60, 40, 20, 0.18);
		transform: rotate(2.5deg);
		max-width: 440px;
		width: 100%;
	}

	.polaroid :global(img) {
		display: block;
		width: 100%;
		height: auto;
	}
</style>
