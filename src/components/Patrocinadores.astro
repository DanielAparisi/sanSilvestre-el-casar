---
import { Image } from "astro:assets";
import lirio from "../assets/patrocinadores/clinica-lirio.jpg";
import rocket from "../assets/patrocinadores/rocket.jpg";
import ibel from "../assets/patrocinadores/ibel.png";
import turismo from "../assets/patrocinadores/turismo-el-casar.jpeg";

// Todos se muestran en una casilla del mismo tamaño: ninguno destaca sobre otro
const patrocinadores = [
  { nombre: "Clínica Lirio", logo: lirio },
  { nombre: "Rocket", logo: rocket },
  // Logo apaisado con fondo azul: rellenamos la casilla con su mismo color
  { nombre: "Inmobiliaria Ibel", logo: ibel, fondo: "#2d3e50" },
  { nombre: "Turismo El Casar", logo: turismo },
];
---

<section id="patrocinadores" class="container patrocinadores">
  <h2 class="section-title">Patrocinadores</h2>
  <p class="script">Gracias por hacer posible esta carrera</p>
  <ul>
    {
      patrocinadores.map((p) => (
        <li>
          <Image
            src={p.logo}
            alt={`Logo de ${p.nombre}`}
            width={480}
            densities={[1, 2]}
            style={p.fondo ? `background: ${p.fondo}; padding: 12px;` : undefined}
          />
          <span>{p.nombre}</span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .patrocinadores {
    padding-block: 40px 88px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .script {
    font-family: var(--font-brush);
    font-size: 26px;
    color: var(--green);
    text-align: center;
    margin-bottom: 20px;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 32px 48px;
  }

  li {
    width: 240px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    font-weight: 800;
    text-align: center;
  }

  img {
    width: 240px;
    height: 240px;
    object-fit: contain;
    background: #fff;
    border: 3px solid var(--ink);
    box-shadow: 6px 6px 0 var(--ink);
  }
</style>
