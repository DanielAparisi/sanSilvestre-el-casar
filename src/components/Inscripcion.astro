<section id="inscripcion" class="inscripcion">
	<div class="card">
		<div class="head">
			<h2 class="section-title">Inscríbete</h2>
			<p>8 € por inscrito · Plazas limitadas</p>
		</div>

		<!-- TODO: conectar con la pasarela de pago / servicio de inscripciones -->
		<form id="form-inscripcion">
			<label>
				Nombre y apellidos
				<input type="text" name="nombre" required placeholder="Ej. Lucía Martín" autocomplete="name" />
			</label>
			<label>
				Correo electrónico
				<input type="email" name="email" required placeholder="tu@correo.com" autocomplete="email" />
			</label>
			<label>
				Categoría
				<select name="categoria">
					<option>Adulto</option>
					<option>Infantil (menor de 14)</option>
				</select>
			</label>
			<label>
				Grupo o peña (opcional)
				<input type="text" name="grupo" placeholder="Para el premio al grupo más numeroso" />
			</label>
			<label class="check">
				<input type="checkbox" name="disfraz" />
				Voy a correr disfrazado/a (opto al premio de disfraces)
			</label>
			<button type="submit" class="btn btn-primary full">Inscribirme · 8 €</button>
		</form>

		<div class="success" hidden>
			<span class="success-title">¡Nos vemos en la salida!</span>
			<span>Te hemos enviado un correo con los pasos para completar el pago.</span>
			<button type="button" class="btn btn-outline" id="otra-inscripcion">Inscribir a otra persona</button>
		</div>
	</div>
</section>

<script>
	const form = document.querySelector<HTMLFormElement>('#form-inscripcion')!;
	const success = document.querySelector<HTMLElement>('.success')!;

	form.addEventListener('submit', (e) => {
		e.preventDefault();
		form.hidden = true;
		success.hidden = false;
	});

	document.querySelector('#otra-inscripcion')!.addEventListener('click', () => {
		form.reset();
		success.hidden = true;
		form.hidden = false;
	});
</script>

<style>
