---
const opciones = [
  {
    title: "Online en YouEvent",
    text: "Inscríbete desde casa en un par de minutos.",
    url: "https://youevent.es/sport/enviar_email_confirmacion.asp",
    cta: "Inscribirme en YouEvent",
  },
  {
    title: "Ayuntamiento de El Casar",
    text: "También puedes apuntarte a través del Ayuntamiento.",
    url: "https://elcasar.es/",
    cta: "Ir a la web del Ayuntamiento",
  },
];
---

<section id="inscripcion" class="container registro">
  <div class="card">
    <h2 class="section-title">Regístrate aquí</h2>
    <p>8 € por inscrito · Plazas limitadas</p>
    <div class="opciones">
      {
        opciones.map((o) => (
          <div class="opcion">
            <h3>{o.title}</h3>
            <p>{o.text}</p>
            <a
              href={o.url}
              class="btn btn-primary"
              target="_blank"
              rel="noopener noreferrer"
            >
              {o.cta}
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .registro {
    padding-block: 40px 80px;
  }

  .card {
    max-width: 760px;
    margin: 0 auto;
    background: #fff;
    border: 3px solid var(--ink);
    border-radius: 24px;
    box-shadow: 8px 8px 0 var(--red);
    padding: 40px 32px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: center;
    text-align: center;
  }

  .card p {
    font-size: 17px;
    color: var(--muted);
  }

  .opciones {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
    margin-top: 8px;
  }

  .opcion {
    border: 2px solid var(--ink);
    border-radius: 18px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: center;
  }

  .opcion .btn {
    margin-top: auto;
  }

  h3 {
    font-size: 20px;
    font-weight: 800;
  }
</style>
