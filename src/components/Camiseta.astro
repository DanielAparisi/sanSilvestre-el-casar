---
import { Image } from "astro:assets";
import camiseta from "../assets/camiseta.jpeg";
import camisetaTrasera from "../assets/camisetaTrasera.jpeg";
---

<section id="camiseta" class="container camiseta">
  <div class="texto">
    <h2 class="section-title">La camiseta</h2>
    <p class="script">¡Luce los colores de la carrera!</p>
    <p>
      Rojo navideño, corredores disfrazados y las casas de El Casar al fondo.
      Así será la camiseta oficial de la III San Silvestre Casareña 2026.
    </p>
  </div>
  <div class="fotos">
    <figure class="foto delante">
      <Image
        src={camiseta}
        alt="Camiseta roja de la III San Silvestre Casareña 2026 con corredores disfrazados de Papá Noel, reno, árbol, muñeco de nieve y elfa"
        width={560}
        densities={[1, 2]}
      />
      <figcaption>Delante</figcaption>
    </figure>
    <figure class="foto detras">
      <Image
        src={camisetaTrasera}
        alt="Parte trasera de la camiseta roja con los logos de los organizadores y patrocinadores: Club Atletismo El Casar, Ayuntamiento de El Casar, Concejalía de Deportes, Juventud, Turismo El Casar, Ibel Inmobiliaria, Clínica Lirio y Rocket"
        width={280}
        densities={[1, 2]}
      />
      <figcaption>Detrás</figcaption>
    </figure>
  </div>
</section>

<style>
  .camiseta {
    padding-block: 40px 88px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 40px 64px;
  }

  .texto {
    flex: 1 1 320px;
    max-width: 480px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    text-align: center;
  }

  .script {
    font-family: var(--font-brush);
    font-size: 28px;
    color: var(--green);
  }

  .texto p:last-child {
    font-size: 17px;
    line-height: 1.55;
    color: var(--muted);
  }

  .fotos {
    flex: 1 1 420px;
    max-width: 640px;
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .foto {
    margin: 0;
    padding: 12px;
    background: #fff;
    border: 3px solid var(--ink);
    box-shadow: 8px 8px 0 var(--ink);
  }

  /* Proporciones: delantera 1:1, trasera ~1:2 → mismas alturas aprox. */
  .delante {
    flex: 2 1 0;
    transform: rotate(2deg);
  }

  .detras {
    flex: 1 1 0;
    transform: rotate(-3deg);
  }

  figcaption {
    margin-top: 8px;
    text-align: center;
    font-family: var(--font-brush);
    font-size: 20px;
    color: var(--ink);
  }

  .foto img {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
