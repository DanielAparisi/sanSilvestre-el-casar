---
import { Image } from "astro:assets";
import club from "../assets/organizadores/club-atletismo.png";
import ayuntamiento from "../assets/organizadores/ayuntamiento.png";

const organizadores = [
  { nombre: "Club de Atletismo El Casar", logo: club },
  { nombre: "Ayuntamiento de El Casar", logo: ayuntamiento },
];
---

<section class="container organizadores">
  <h2 class="titulo">Organizado por</h2>
  <ul>
    {
      organizadores.map((o) => (
        <li>
          <Image src={o.logo} alt={`Logo del ${o.nombre}`} height={160} densities={[1, 2]} />
          <span>{o.nombre}</span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .organizadores {
    padding-bottom: 88px;
    text-align: center;
  }

  .titulo {
    font-family: var(--font-brush);
    font-weight: 400;
    font-size: clamp(26px, 3.5vw, 38px);
    color: var(--muted);
    margin-bottom: 28px;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 32px 72px;
  }

  li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    font-weight: 800;
  }

  img {
    height: 160px;
    width: auto;
  }</style>
